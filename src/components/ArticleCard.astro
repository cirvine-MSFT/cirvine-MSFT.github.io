---
interface Props {
  title: string;
  description: string;
  pubDate: string;
  slug: string;
  tags?: string[];
  draft?: boolean;
}

const { title, description, pubDate, slug, tags, draft = false } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<a href={`/articles/${slug}`} class="block glass-card p-6 group">
  <div class="flex items-center gap-2 mb-2">
    <p class="text-xs uppercase tracking-widest" style="color: var(--color-text-muted);">
      {formattedDate}
    </p>
    {draft && (
      <span
        class="text-xs uppercase tracking-widest px-2 py-0.5 rounded-full"
        style="background: rgba(57,255,20,0.1); color: var(--color-accent-green);"
      >
        Draft
      </span>
    )}
  </div>
  <h3 class="text-lg font-semibold mb-2 group-hover:text-[var(--color-accent-green)] transition-colors" style="color: var(--color-text-primary);">
    {title}
  </h3>
  <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
    {description}
  </p>
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-4">
      {tags.map((tag) => (
        <span class="text-xs px-2 py-0.5 rounded-full" style="background: rgba(168,85,247,0.1); color: var(--color-accent-purple);">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
